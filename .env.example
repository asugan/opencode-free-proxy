# Generate a unique key: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PROXY_API_KEY=replace-with-your-own-random-key-at-least-24-characters
HOST=127.0.0.1
PORT=8787

# Optional upstream credential. Leave empty to use OpenCode's public credential.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
REQUEST_TIMEOUT_MS=300000

# Omit to use curated free chat model list. This REPLACES the entire allowlist.
# Check current pricing before adding models; upstream may charge your account.
# ALLOWED_MODELS=big-pickle,glm-5.3-flash-free
