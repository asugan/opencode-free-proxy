{
  "name": "opencode-free-proxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenAI-compatible OpenCode gateway for CLIProxyAPI",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
